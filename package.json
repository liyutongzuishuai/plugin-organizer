{
  "name": "dsh-plugin-organizer",
  "version": "1.7.0",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "README.md",
    "LICENSE",
    "nav-config.json",
    "scripts/build-config.mjs",
    "scripts/nav.mjs",
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "description": "Groups plugin-added settings entries: a standalone animated panel plus an in-navigation band split, driven by nav-config.json.",
  "license": "MIT",
  "author": "liyutongzuishuai",
  "homepage": "https://github.com/liyutongzuishuai/plugin-organizer#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liyutongzuishuai/plugin-organizer.git"
  },
  "bugs": {
    "url": "https://github.com/liyutongzuishuai/plugin-organizer/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "settings",
    "navigation",
    "ui"
  ]
}
